# ============================================================================
# Cannoli Pokemon Showdown — Environment Variables
# ============================================================================
#
# This file documents every env var the PS stack and Cannoli backend need to
# talk to each other. There are FOUR places where env vars get set:
#
#   1. Cannoli BACKEND service (cannoli.live)        — the login server + bot
#   2. Cannoli FRONTEND service (cannoli.live)       — VITE_SHOWDOWN_URL only
#   3. Pokemon Showdown SERVER service (sim.cannoli.live, port 8000)
#   4. Pokemon Showdown CLIENT service (sim.cannoli.live, port 80)
#
# In Coolify, paste each block below into the corresponding service's "Env Vars"
# tab. NEVER commit the actual values of PS_RSA_PRIVATE_KEY or BOT_PASSWORD.
#
# The RSA keypair lives in this directory:
#   showdown/ps_private.pem  → goes on the BACKEND as PS_RSA_PRIVATE_KEY
#   showdown/ps_public.pem   → goes on the PS SERVER as PS_RSA_PUBLIC_KEY
# Both files are .gitignored. Re-generate with:
#   openssl genrsa -out showdown/ps_private.pem 2048
#   openssl rsa -in showdown/ps_private.pem -pubout -out showdown/ps_public.pem
#
# ============================================================================
# 1. CANNOLI BACKEND (cannoli.live)
# ============================================================================

CANNOLI_MODE=live
NODE_ENV=production

# DB path — must NOT contain "live", "prod", or "production" if CANNOLI_MODE=mock
# (the backend has a boot guard that refuses to start in that combination).
CANNOLI_DB_PATH=/data/cannoli-live.db

# Bot account credentials. Create this user in the backend DB (admin panel)
# AND ensure it appears in showdown/server/config/usergroups.csv as `cannolibot,+`
# (the Dockerfile.server already adds it; verify after build).
BOT_USERNAME=CannoliBot
BOT_PASSWORD=replace-with-strong-random-password

# Game server WebSocket URL the bot connects to.
# Production: through the public domain (TLS terminates at the client/nginx).
PS_SERVER_WS_URL=wss://sim.cannoli.live/showdown/websocket

# Hostname embedded in signed assertions. Must match the legalhosts in the
# game server's config (currently ['cannoli.live', 'sim.cannoli.live']).
PS_HOSTNAME=sim.cannoli.live

# Key ID — must match PS_KEY_ID on the game server. Default is 4.
PS_KEY_ID=4

# RSA private key (PEM). Newlines can be escaped as \n; the loader replaces them.
# Paste the contents of showdown/ps_private.pem here as a single quoted string
# in Coolify's secret env var input.
#
# SYMPTOM IF MISSING: bot starts, connects, requests challstr, then logs
#   "Failed to sign assertion — check PS_RSA_PRIVATE_KEY"
# and sits there silently disconnected. No battles will be detected.
PS_RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkq...\n...\n-----END PRIVATE KEY-----"

# Shared secret used by the PS server's startup hook to fetch active leagues
# from /api/internal/ps/leagues (so it can spin up matching chat rooms).
# Generate with: openssl rand -hex 32
# Must match PS_INTERNAL_SECRET on cannoli-ps-server.
PS_INTERNAL_SECRET=replace-with-shared-random-hex

# ============================================================================
# 2. CANNOLI FRONTEND (cannoli.live)
# ============================================================================

# URL the Play tab iframe loads. In production this is the public client URL.
VITE_SHOWDOWN_URL=https://sim.cannoli.live/

# ============================================================================
# 3. POKEMON SHOWDOWN GAME SERVER (Coolify service: ps-server)
# ============================================================================

# Where the game server forwards login/upkeep/getassertion requests.
# This is the Cannoli backend's PS endpoints.
PS_LOGIN_SERVER_URL=https://cannoli.live/api/ps/

# Must match the backend's PS_KEY_ID.
PS_KEY_ID=4

# RSA public key (PEM). Paste contents of showdown/ps_public.pem.
# The game server uses this to verify the signed assertions the backend issues.
#
# SYMPTOM IF WRONG: clients see |nametaken| Your verification signature doesn't match
# in the chat console; they end up as guests.
PS_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkq...\n...\n-----END PUBLIC KEY-----"

# Where the PS startup hook fetches active leagues from. Must include the
# scheme + host + port (no trailing /api/...). On Coolify this is the
# internal docker alias for the active backend; locally it's the host.
#   mock deploy: http://cannoli-backend-mock:3001
#   live deploy: http://cannoli-backend-live:3001
#   dev compose: http://host.docker.internal:3001
CANNOLI_BACKEND_URL=http://cannoli-backend-mock:3001

# Must match PS_INTERNAL_SECRET on the Cannoli backend (above).
PS_INTERNAL_SECRET=replace-with-shared-random-hex

# ============================================================================
# 4. POKEMON SHOWDOWN CLIENT (Coolify service: ps-client, nginx)
# ============================================================================

# Internal hostname of the game server (nginx upstream target for /showdown/websocket).
# In Coolify, this is whatever you named the ps-server service in the same project
# network (e.g. "ps-server"). In compose, this is the service name "ps-server".
PS_SERVER_HOST=ps-server

# Internal hostname of the Cannoli backend (nginx upstream for /action.php fallback).
# Most auth XHRs go directly to https://cannoli.live/api/ps/ via the client config,
# but testclient.html builds /action.php URLs against Config.routes.client. This
# proxy catches those.
PS_LOGIN_HOST=cannoli-backend
