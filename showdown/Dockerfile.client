# syntax=docker/dockerfile:1.7
#
# Pokemon Showdown client (Cannoli fork) + nginx reverse proxy for sim.cannoli.live.
#
# Serves:
#   /                         → static PS client (testclient.html as index)
#   /replay/                  → replay viewer
#   /showdown/websocket       → reverse-proxied to game server (PS_SERVER_HOST:8000)
#   /action.php               → reverse-proxied to Cannoli backend (PS_LOGIN_HOST:3001/api/ps/action.php)
#                               Most XHRs go directly to https://cannoli.live/api/ps/, this is a
#                               fallback for testclient.html that builds action.php URLs from Config.routes.client.
#
# BUILD CONTEXT: cannoli repo root.
#   Local:   docker build -f showdown/Dockerfile.client -t cannoli-ps-client .
#   Coolify: Build Context = `/`, Dockerfile = `showdown/Dockerfile.client`
#
# RUNTIME ENV:
#   PS_SERVER_HOST  — hostname of the game server container (compose: ps-server; Coolify: internal service name)
#   PS_LOGIN_HOST   — hostname of the cannoli backend container (compose: cannoli-backend; Coolify: backend service name)
#
# EXPOSED PORT: 80

FROM node:20-slim AS build
WORKDIR /client

# Clone official Pokemon Showdown client (shallow). Pin via PS_CLIENT_REF for reproducibility.
ARG PS_CLIENT_REPO=https://github.com/smogon/pokemon-showdown-client.git
# PINNED to a known-good commit (2026-05-14, the era this integration was built).
# Upstream `master` later changed the client build so it no longer produces
# play.pokemonshowdown.com/testclient.html — which is both the nginx `index` and
# the SSO entrypoint — breaking the image build (was an unpinned `master`).
# Bump deliberately only after verifying testclient.html still survives the build.
ARG PS_CLIENT_REF=aca6c94dd03ca0d7764475eb16f869cb50967910
# git for the fetch; php-cli for the client build's cachebuster/news step which
# shells out to `php` (node:20-slim has none).
RUN apt-get update && apt-get install -y git php-cli && rm -rf /var/lib/apt/lists/*
# Shallow-fetch the exact pinned commit. `git clone --branch` only accepts a
# branch/tag name, not a raw SHA, so init + fetch the single commit instead.
RUN git init -q . \
    && git remote add origin ${PS_CLIENT_REPO} \
    && git fetch --depth 1 origin ${PS_CLIENT_REF} \
    && git checkout -q FETCH_HEAD \
    && rm -rf .git

# Replace upstream jQuery with clean stock version. Smogon's distributed
# jquery-2.2.4.min.js has injected code that mutates `challstr` field on
# $.post/$.get to append a browser fingerprint (timezone, screen size, canvas
# hash) before sending to the login server. Their official login server strips
# this; ours doesn't, so the appended bytes break RSA assertion verification
# (yields `|nametaken| Your verification signature doesn't match`). Drop in
# the upstream-clean jQuery from code.jquery.com instead.
RUN apt-get update && apt-get install -y curl ca-certificates && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://code.jquery.com/jquery-2.2.4.min.js \
       -o play.pokemonshowdown.com/js/lib/jquery-2.2.4.min.js \
    && echo "05b85d96f41fff14d8f608dad03ab71e2c1017c2da0914d7c59291bad7a54f8e  play.pokemonshowdown.com/js/lib/jquery-2.2.4.min.js" \
       | sha256sum -c -

# Copy Cannoli config files. The smogon source tree expects them at /config/
# (one level up from /play.pokemonshowdown.com/), but nginx will only serve the
# play.pokemonshowdown.com subdirectory — anything outside is unreachable. So
# put our configs both at /config/ (used by `node build`) AND inside the served
# tree at play.pokemonshowdown.com/config/ (used at runtime by patched HTML).
COPY showdown/ps-client-config.js config/config.js
COPY showdown/ps-testclient-key.js config/testclient-key.js
COPY showdown/ps-client-config.js play.pokemonshowdown.com/config/config.js
COPY showdown/ps-testclient-key.js play.pokemonshowdown.com/config/testclient-key.js

# Pin the transitive pokemon-showdown (sim/server) dependency. `build-indexes`
# clones the server repo and `git pull`s it to master HEAD to generate the data
# files — upstream master drifted incompatibly (dist/sim/dex.js TypeError),
# breaking `node build full`. Replace that `git pull` with a checkout of a server
# commit from the pinned-client era so the data build is reproducible. (Only
# build-indexes fetches it; build-learnsets/build-minidex just read its dist.)
ARG PS_SERVER_REF=e1290bb1fc267e70d474c6a56e2f4d860bb86cf9
RUN sed -i "s|git pull|git checkout ${PS_SERVER_REF}|" build-tools/build-indexes

# Build the client (generates data files, compiled JS)
RUN node build full

# Cannoli news overlay. Served from the client root and loaded by testclient.html
# (patched in below). Copied AFTER the build so the build step can't clobber it.
COPY showdown/ps-news.js play.pokemonshowdown.com/ps-news.js

# Patch testclient.html and index.html so they load our local config instead of
# Smogon's CDN (which would otherwise hard-code Config.server to sim3.psim.us
# and Config.loginserver to play.pokemonshowdown.com — connecting users to the
# official Smogon server instead of our private one).
RUN for f in testclient.html index.html; do \
        if [ -f "play.pokemonshowdown.com/$f" ]; then \
            sed -i \
                -e 's|https://play.pokemonshowdown.com/config/config.js|config/config.js|g' \
                -e 's|//play.pokemonshowdown.com/config/config.js[^"]*|config/config.js|g' \
                -e 's|\.\./config/testclient-key.js|config/testclient-key.js|g' \
                "play.pokemonshowdown.com/$f"; \
        fi; \
    done
# Cannoli embed tweaks. sim.cannoli.live is only ever shown iframed inside the
# Cannoli Showdown page, so the PS lobby's own footer chrome (the "Pokémon
# Showdown | Smogon / Pokédex | Replays | Rules | Forum" strip in
# .mainmenufooter) is redundant — it just eats vertical space and sits awkwardly
# above our arena bar. Hide it so the lobby content sits flush above the bar.
#
# Also hide the "Change name"/"Choose name" buttons (every login-panel trigger is
# a `button[data-href="login"]`). Identity is bound to the Cannoli SSO session —
# the backend only ever signs an assertion for the logged-in user's own userid,
# so a rename can't actually succeed — but there's no reason to show users a
# control that looks like it lets them change who they are. Auto-login via the
# SSO assertion means they never need to open the login panel manually.
RUN for f in testclient.html index.html; do \
        if [ -f "play.pokemonshowdown.com/$f" ]; then \
            sed -i 's#</title>#</title><style>.mainmenufooter{display:none!important}button[data-href="login"]{display:none!important}</style>#' \
                "play.pokemonshowdown.com/$f"; \
        fi; \
    done

# Cannoli news box. testclient.html bakes a static "Test client / Welcome to the
# test client!" placeholder into the page (the legacy client never refreshes it
# on load). Replace it with a Cannoli welcome — that's the fallback shown when no
# site announcement is set — and load ps-news.js, which overlays the live
# /admin/site-settings announcement when one exists (via the /news.json proxy).
# Only testclient.html is patched: it's the served entrypoint (nginx index=
# testclient.html); index.html is never served and its built-in news layout
# differs. The greps fail the build if a sed missed (e.g. upstream changed the
# placeholder markup) so we never silently re-ship the stale test-client message.
RUN sed -i 's#<div class="newsentry">.*</div>#<div class="newsentry"><h4>Welcome to the Cannoli sim</h4><p>This server hosts our Pokemon draft tournament leagues. Coaches are auto-joined into their league chat room on login. Visit the league pages for standings, draft boards, and matchup tools.</p><p>-<strong>Cannoli</strong></p></div>#' play.pokemonshowdown.com/testclient.html \
    && sed -i 's#</body>#<script src="ps-news.js"></script></body>#' play.pokemonshowdown.com/testclient.html \
    && grep -q 'Welcome to the Cannoli sim' play.pokemonshowdown.com/testclient.html \
    && grep -q 'src="ps-news.js"' play.pokemonshowdown.com/testclient.html \
    && ! grep -q 'Welcome to the test client' play.pokemonshowdown.com/testclient.html

# Showdex overlay injection. The standalone bundle is deployed to /showdex/ in
# the final image (built in the `showdex` stage). Per Showdex's dev-zone embed
# instructions: add its web fonts (Work Sans + Fira Code) to <head>, and load
# the bundle after the PS client app exists.
#
# Showdex detects its host (classic vs preact client) the instant main.js runs,
# and aborts with "Showdex attempted to start in an unsupported website" if
# neither `window.app` (classic) nor `window.PS` (preact) is present yet. A plain
# <script> at end-of-body runs during parse — BEFORE the classic client's jQuery
# ready handler constructs `window.app` — so it loses that race and bails. Defer
# the load: poll for `window.app`, then inject main.js (the README's documented
# "timing issues" workaround, hardened with a poll + ~10s cap).
#
# The `\&` keeps sed from expanding the `&display=swap` query as the match. The
# grep-guards fail the build if an anchor wasn't matched, so we never silently
# ship the client without the overlay.
RUN sed -i \
        -e 's#</head>#<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900\&display=swap"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700\&display=swap"></head>#' \
        -e 's#</body>#<script>(function(){function go(){var s=document.createElement("script");s.src="/showdex/main.js";document.body.appendChild(s);}var n=0,t=setInterval(function(){if(window.app||window.PS||n++>200){clearInterval(t);go();}},50);})();</script></body>#' \
        play.pokemonshowdown.com/testclient.html \
    && grep -q '/showdex/main.js' play.pokemonshowdown.com/testclient.html \
    && grep -q 'family=Work+Sans' play.pokemonshowdown.com/testclient.html

# Cannoli Matchup Center plugin injection. The standalone bundle is deployed
# to /cannoli-matchup/ in the final image (built in the `matchup` stage below).
# Same deferred-load pattern as the Showdex block above: poll for window.app,
# then append the script. Unlike Showdex this is an ES MODULE (type="module") —
# it lazy-loads its ~1.2MB learnsets chunk from /cannoli-matchup/chunks/ only
# when the Moves tab first opens, so the client boot cost stays small. The
# grep-guard fails the build if the anchor wasn't matched, so we never silently
# ship the client without the Matchup tab.
RUN sed -i \
        's#</body>#<script>(function(){function go(){var s=document.createElement("script");s.type="module";s.src="/cannoli-matchup/matchup.js";document.body.appendChild(s);}var n=0,t=setInterval(function(){if(window.app||n++>200){clearInterval(t);go();}},50);})();</script></body>#' \
        play.pokemonshowdown.com/testclient.html \
    && grep -q '/cannoli-matchup/matchup.js' play.pokemonshowdown.com/testclient.html

# Fail the build (rather than ship a broken client) if the entrypoint HTML the
# nginx `index` directive serves wasn't produced — that's the symptom of the
# php-less build silently dropping testclient.html.
RUN test -f play.pokemonshowdown.com/testclient.html \
    || (echo "FATAL: testclient.html missing after build — upstream client build changed" && exit 1)

# Dereference symlinks in the served tree. Upstream ships
# play.pokemonshowdown.com/config/{config,colors,coil,config-test}.* as
# relative symlinks into ../../config/. Docker COPY preserves symlinks, so
# once /client/play.pokemonshowdown.com is copied into the nginx image those
# targets land outside the destination root and the symlinks dangle —
# /config/config.js then 404s and nginx serves testclient.html as the body,
# which the browser tries to parse as JS. Replace each symlink with the
# resolved file content so it survives the multistage copy.
RUN find play.pokemonshowdown.com -type l | while read -r link; do \
        target=$(readlink -f "$link"); \
        if [ -e "$target" ]; then \
            rm "$link"; \
            cp "$target" "$link"; \
        fi; \
    done

# ─────────────────────────────────────────────────────────────────────────────
# Showdex overlay (standalone build).
#
# Showdex (https://github.com/doshidak/showdex) is the Pokémon Showdown damage-
# calculator extension. Its "standalone" BUILD_TARGET strips the WebExtension
# APIs and emits a plain <script> bundle meant to be embedded into a self-hosted
# pokemon-showdown-client (per its README "Developer Zone") — so every
# sim.cannoli.live visitor gets Showdex with ZERO browser-extension install. The
# bundle is deployed to /showdex/ (its default STANDALONE_RESOURCE_PREFIX) and
# the <script> is injected into testclient.html in the build stage above.
#
# Needs node 24 + pnpm 10 (the client stage is node 20), so it builds separately.
# Pinned to doshidak/showdex master == v1.3.0 for reproducibility — bump
# deliberately (and re-verify the emit guard below still passes).
FROM node:24-slim AS showdex
WORKDIR /showdex
ARG SHOWDEX_REPO=https://github.com/doshidak/showdex.git
ARG SHOWDEX_REF=ac314a79dba06441e73c07855afb60229df1aeca
# git to fetch; python3/make/g++ for any node-gyp native deps.
RUN apt-get update && apt-get install -y git python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
RUN git init -q . \
    && git remote add origin ${SHOWDEX_REPO} \
    && git fetch --depth 1 origin ${SHOWDEX_REF} \
    && git checkout -q FETCH_HEAD \
    && rm -rf .git
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
RUN pnpm install --no-frozen-lockfile
# v1.3.0 BUG: src/components/form/Composer statically imports five @lexical/*
# subpackages that aren't declared as direct deps, so pnpm's strict layout never
# links them at top level → webpack can't resolve them → the compile errors and
# NoEmitOnErrorsPlugin suppresses ALL output. Worse, scripts/build.js only checks
# webpack's fatal `err` (not stats.hasErrors()), so it prints "successful!" while
# emitting nothing. Declare the missing siblings (lockstep-versioned with the
# lexical core that IS declared, ^0.42.0) so the build actually produces a bundle.
RUN pnpm add \
      '@lexical/rich-text@^0.42.0' \
      '@lexical/link@^0.42.0' \
      '@lexical/list@^0.42.0' \
      '@lexical/code@^0.42.0' \
      '@lexical/markdown@^0.42.0'
# `:fast` skips the bundle-size analyzer. Outputs to dist/standalone/.
RUN pnpm build:standalone:fast
# scripts/build.js lies about success (see above), so verify the entry actually
# emitted. If a future SHOWDEX_REF reintroduces a silent-empty build, fail HERE
# rather than ship a client whose <script src="/showdex/main.js"> 404s.
RUN test -f dist/standalone/main.js \
    || (echo "FATAL: showdex standalone build emitted no main.js (compile errors swallowed by scripts/build.js)" && exit 1)

# ─────────────────────────────────────────────────────────────────────────────
# Cannoli Matchup Center plugin (standalone build).
#
# The Showdown-native Matchup Center tab (frontend/src/plugins/matchup/) — a
# `view-matchup` client room registered beside Showdex's Hellodex. Built from
# the cannoli frontend workspace with its standalone vite config
# (frontend/vite.plugin.config.ts → dist-plugin/: matchup.js entry + lazy
# chunks). Deployed to /cannoli-matchup/ and injected into testclient.html in
# the build stage above. Mirrors frontend/Dockerfile's workspace install
# (manifests first for layer caching); vite build only, no tsc (typecheck is a
# CI gate, not an image-build job — same rationale as the frontend image).
FROM oven/bun:1 AS matchup
WORKDIR /cannoli

COPY package.json bun.lock ./
COPY frontend/package.json frontend/package.json
COPY backend/package.json backend/package.json
RUN bun install --frozen-lockfile

COPY frontend/ frontend/

# Absolute Cannoli API origin baked into the bundle (the sim origin has no
# /api proxy). Override at build time to point a mock-era client at
# https://mock.cannoli.live; a page-level `window.CANNOLI_MATCHUP_API_BASE`
# (set before the module loads) can still repoint it at runtime.
ARG MATCHUP_API_BASE=https://cannoli.live
RUN cd frontend && VITE_MATCHUP_API_BASE=${MATCHUP_API_BASE} bun run build:plugin
# vite exits 0 on some config mistakes that emit nothing — fail HERE rather
# than ship a client whose injected /cannoli-matchup/matchup.js 404s.
RUN test -f frontend/dist-plugin/matchup.js \
    || (echo "FATAL: matchup plugin build emitted no matchup.js" && exit 1)

FROM nginx:alpine

# Copy built client files
COPY --from=build /client/play.pokemonshowdown.com /usr/share/nginx/html

# Showdex standalone bundle → /showdex/ (its default resource prefix). nginx's
# catch-all `location /` try_files serves these as static files; no routing
# change needed. main.js is loaded by testclient.html (patched in the build stage).
COPY --from=showdex /showdex/dist/standalone /usr/share/nginx/html/showdex

# Cannoli Matchup Center plugin bundle → /cannoli-matchup/ (entry + lazy
# chunks). Served the same static way; loaded by the module-script injection
# patched into testclient.html in the build stage.
COPY --from=matchup /cannoli/frontend/dist-plugin /usr/share/nginx/html/cannoli-matchup

# Also copy upstream replay viewer (PHP — currently non-functional under
# nginx-only, kept for static asset companions like /replay/style/).
COPY --from=build /client/replay.pokemonshowdown.com /usr/share/nginx/html/replay

# Cannoli's standalone replay embed page. Iframed by the Cannoli site at
# /replay/embed.html?match=<id>; fetches the log via /replay/data/<id>.json
# (proxied to the cannoli backend by nginx). Overwrites the upstream
# /replay/embed.html if any (there isn't one) — this is the entry point
# the cannoli frontend points at.
COPY showdown/cannoli-replay-embed.html /usr/share/nginx/html/replay/embed.html

# Nginx config template (envsubst for PS_SERVER_HOST / PS_LOGIN_HOST)
COPY showdown/nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
