# syntax=docker/dockerfile:1.7
#
# Pokemon Showdown client (Cannoli fork) + nginx reverse proxy for sim.cannoli.live.
#
# Serves:
#   /                         → static PS client (testclient.html as index)
#   /replay/                  → replay viewer
#   /showdown/websocket       → reverse-proxied to game server (PS_SERVER_HOST:8000)
#   /action.php               → reverse-proxied to Cannoli backend (PS_LOGIN_HOST:3001/api/ps/action.php)
#                               Most XHRs go directly to https://cannoli.live/api/ps/, this is a
#                               fallback for testclient.html that builds action.php URLs from Config.routes.client.
#
# BUILD CONTEXT: cannoli repo root.
#   Local:   docker build -f showdown/Dockerfile.client -t cannoli-ps-client .
#   Coolify: Build Context = `/`, Dockerfile = `showdown/Dockerfile.client`
#
# RUNTIME ENV:
#   PS_SERVER_HOST  — hostname of the game server container (compose: ps-server; Coolify: internal service name)
#   PS_LOGIN_HOST   — hostname of the cannoli backend container (compose: cannoli-backend; Coolify: backend service name)
#
# EXPOSED PORT: 80

FROM node:20-slim AS build
WORKDIR /client

# Clone official Pokemon Showdown client (shallow). Pin via PS_CLIENT_REF for reproducibility.
ARG PS_CLIENT_REPO=https://github.com/smogon/pokemon-showdown-client.git
ARG PS_CLIENT_REF=master
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${PS_CLIENT_REF} ${PS_CLIENT_REPO} . \
    && rm -rf .git

# Replace upstream jQuery with clean stock version. Smogon's distributed
# jquery-2.2.4.min.js has injected code that mutates `challstr` field on
# $.post/$.get to append a browser fingerprint (timezone, screen size, canvas
# hash) before sending to the login server. Their official login server strips
# this; ours doesn't, so the appended bytes break RSA assertion verification
# (yields `|nametaken| Your verification signature doesn't match`). Drop in
# the upstream-clean jQuery from code.jquery.com instead.
RUN apt-get update && apt-get install -y curl ca-certificates && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://code.jquery.com/jquery-2.2.4.min.js \
       -o play.pokemonshowdown.com/js/lib/jquery-2.2.4.min.js \
    && echo "05b85d96f41fff14d8f608dad03ab71e2c1017c2da0914d7c59291bad7a54f8e  play.pokemonshowdown.com/js/lib/jquery-2.2.4.min.js" \
       | sha256sum -c -

# Copy Cannoli config files. The smogon source tree expects them at /config/
# (one level up from /play.pokemonshowdown.com/), but nginx will only serve the
# play.pokemonshowdown.com subdirectory — anything outside is unreachable. So
# put our configs both at /config/ (used by `node build`) AND inside the served
# tree at play.pokemonshowdown.com/config/ (used at runtime by patched HTML).
COPY showdown/ps-client-config.js config/config.js
COPY showdown/ps-testclient-key.js config/testclient-key.js
COPY showdown/ps-client-config.js play.pokemonshowdown.com/config/config.js
COPY showdown/ps-testclient-key.js play.pokemonshowdown.com/config/testclient-key.js

# Build the client (generates data files, compiled JS)
RUN node build full

# Patch testclient.html and index.html so they load our local config instead of
# Smogon's CDN (which would otherwise hard-code Config.server to sim3.psim.us
# and Config.loginserver to play.pokemonshowdown.com — connecting users to the
# official Smogon server instead of our private one).
RUN sed -i \
        -e 's|https://play.pokemonshowdown.com/config/config.js|config/config.js|g' \
        -e 's|//play.pokemonshowdown.com/config/config.js[^"]*|config/config.js|g' \
        -e 's|\.\./config/testclient-key.js|config/testclient-key.js|g' \
        play.pokemonshowdown.com/testclient.html play.pokemonshowdown.com/index.html

FROM nginx:alpine

# Copy built client files
COPY --from=build /client/play.pokemonshowdown.com /usr/share/nginx/html

# Also copy replay viewer
COPY --from=build /client/replay.pokemonshowdown.com /usr/share/nginx/html/replay

# Nginx config template (envsubst for PS_SERVER_HOST / PS_LOGIN_HOST)
COPY showdown/nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 80
