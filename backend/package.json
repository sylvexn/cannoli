{
  "name": "@cannoli/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "seed": "bun run scripts/seed.ts",
    "seed:activity": "bun run scripts/seed-activity.ts",
    "seed:fresh": "bun run scripts/seed-fresh.ts",
    "seed:s11": "CANNOLI_SEED_SEASON=11 bun run scripts/seed.ts",
    "seed:s11:fresh": "CANNOLI_SEED_SEASON=11 bun run scripts/seed-fresh.ts",
    "test": "bun test tests/"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "bcryptjs": "^3.0.3",

    "drizzle-orm": "^0.45.2",
    "elysia": "^1.2.0",
    "octokit": "^5.0.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",

    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.31.10"
  }
}
