{
  "name": "cannoli",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "bash scripts/dev-all.sh",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:backend": "bun run --cwd backend dev",
    "dev:simple": "bun run --cwd backend dev & bun run --cwd frontend dev",
    "setup:showdown": "bash scripts/setup-showdown.sh",
    "build": "bun run --cwd frontend build",
    "check": "bun run --cwd frontend check",
    "lint": "bun run --cwd frontend lint"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.2.8"
  }
}
